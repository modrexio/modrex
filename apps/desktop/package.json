{
    "name": "modrex",
    "version": "0.12.2",
    "type": "module",
    "packageManager": "pnpm@10.32.1",
    "scripts": {
        "dev": "tauri dev",
        "dev-renderer": "vite",
        "build": "tauri build --config src-tauri/tauri.local.conf.json",
        "build:signed": "tauri build",
        "build-renderer": "vite build",
        "dist": "tauri build --config src-tauri/tauri.local.conf.json",
        "dist:win": "tauri build --target x86_64-pc-windows-msvc --config src-tauri/tauri.local.conf.json",
        "dist:linux": "tauri build --target x86_64-unknown-linux-gnu --config src-tauri/tauri.local.conf.json",
        "typecheck": "tsc --noEmit",
        "check-version": "node scripts/check-version.mjs",
        "check-commands": "node scripts/check-commands.mjs",
        "check-csp": "node scripts/check-csp.mjs",
        "check-games": "node scripts/check-games.mjs",
        "check-sources": "node scripts/check-sources.mjs",
        "check-updater": "node scripts/check-updater.mjs",
        "check-i18n": "node scripts/check-i18n.mjs",
        "checks": "pnpm check-version && pnpm check-commands && pnpm check-csp && pnpm check-games && pnpm check-sources && pnpm check-updater && pnpm check-i18n && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
        "version": "node scripts/version.mjs",
        "test": "cargo test --manifest-path src-tauri/Cargo.toml && vitest run",
        "test:renderer": "vitest run",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint src/renderer/src",
        "lint:fix": "eslint src/renderer/src --fix",
        "generate-licenses": "node scripts/generate-licenses.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/modrexio/modrex.git"
    },
    "keywords": [
        "modrex",
        "payday3",
        "payday2",
        "payday-the-heist",
        "crime-boss",
        "mod-manager"
    ],
    "author": "Oleh Shulha",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/modrexio/modrex/issues"
    },
    "homepage": "https://github.com/modrexio/modrex#readme",
    "description": "A desktop mod manager for PAYDAY 3, PAYDAY 2, PAYDAY: The Heist, and Crime Boss: Rockay City powered by modworkshop",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.5",
        "eslint": "^10.8.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.8.0",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.2.0",
        "vite-plugin-svgr": "^5.2.0",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@modrex/games": "workspace:*",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-popover": "^1.1.23",
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-tabs": "^1.1.21",
        "@radix-ui/react-tooltip": "^1.2.16",
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-log": "^2.9.0",
        "bbcode-to-react": "^0.2.9",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "highlight.js": "^11.11.1",
        "lucide-react": "^1.28.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-markdown": "^10.1.0",
        "rehype-highlight": "^7.0.2",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "remark-breaks": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "simple-icons": "^16.27.1",
        "tailwind-merge": "^3.6.0"
    }
}
