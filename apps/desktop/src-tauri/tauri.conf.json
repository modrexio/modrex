{
    "productName": "Modrex",
    "version": "0.14.0",
    "identifier": "modrex",
    "build": {
        "beforeDevCommand": "pnpm run dev-renderer",
        "beforeBuildCommand": "pnpm run build-renderer && pnpm run build:pakviewer",
        "frontendDist": "../out/renderer",
        "devUrl": "http://localhost:5173"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Modrex",
                "width": 1200,
                "height": 800,
                "minWidth": 900,
                "minHeight": 600,
                "center": true,
                "backgroundColor": "#131313",
                "decorations": false,
                "visible": false,
                "dragDropEnabled": true
            },
            {
                "label": "splash",
                "title": "Starting Modrex",
                "url": "splash.html",
                "width": 520,
                "height": 300,
                "center": true,
                "resizable": false,
                "maximizable": false,
                "minimizable": false,
                "fullscreen": false,
                "backgroundColor": "#131313",
                "decorations": false,
                "visible": false,
                "skipTaskbar": true,
                "dragDropEnabled": false
            }
        ],
        "security": {
            "csp": "default-src 'self'; img-src 'self' thumb: http://thumb.localhost https://storage.modworkshop.net https://cdn.akamai.steamstatic.com https://img.youtube.com https://cdn-cf-east.streamable.com https://www.paydaythegame.com https://staticdelivery.nexusmods.com data:; frame-src https://www.youtube.com https://streamable.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'",
            "devCsp": "default-src 'self'; img-src 'self' thumb: http://thumb.localhost https://storage.modworkshop.net https://cdn.akamai.steamstatic.com https://img.youtube.com https://cdn-cf-east.streamable.com https://www.paydaythegame.com https://staticdelivery.nexusmods.com data:; frame-src https://www.youtube.com https://streamable.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:* http://localhost:* ws://127.0.0.1:* http://127.0.0.1:*; object-src 'none'; base-uri 'self'",
            "dangerousDisableAssetCspModification": ["style-src"]
        }
    },
    "bundle": {
        "active": true,
        "createUpdaterArtifacts": true,
        "targets": ["nsis", "deb", "rpm", "appimage"],
        "icon": [
            "icons/32x32.png",
            "icons/64x64.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "license": "../../../LICENSE",
        "resources": ["../THIRD_PARTY_LICENSES.md", "resources/pakviewer/*"],
        "linux": {
            "deb": {
                "conflicts": ["pd3-mod-manager"],
                "replaces": ["pd3-mod-manager"],
                "desktopTemplate": "linux/main.desktop"
            },
            "rpm": {
                "obsoletes": ["pd3-mod-manager"],
                "desktopTemplate": "linux/main.desktop"
            }
        },
        "windows": {
            "nsis": {
                "installMode": "currentUser",
                "startMenuFolder": "Games",
                "installerHooks": "nsis/installer-hooks.nsi"
            }
        }
    },
    "plugins": {
        "deep-link": {
            "desktop": {
                "schemes": ["nxm", "modrex"]
            }
        },
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwMzYwODUwNUFCRDhENwpSV1RYMktzRmhXQURBaktoVnhUZS9DeFMvSFQrUzNpTXFyUW9yWFNQL1FVRTIwUmp6SVNWUlViVgo=",
            "endpoints": [
                "https://github.com/modrexio/modrex/releases/latest/download/latest.json"
            ],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
