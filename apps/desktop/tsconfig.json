{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "incremental": true,
        "types": ["node", "vite-plugin-svgr/client"],
        "resolveJsonModule": true
    },
    "include": ["src/**/*", "vite.config.*"],
    "exclude": ["node_modules", "out", "commitlint.config.ts", "src/main", "src/preload"]
}
