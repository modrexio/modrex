{
    "name": "modrex-site",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "typecheck": "astro check",
        "typecheck:functions": "tsc -p functions/tsconfig.json",
        "check-legal-dates": "bun scripts/check-legal-dates.mjs",
        "test": "vitest",
        "test:run": "bun run test:cache-security && vitest run",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:cache-security": "bun test ./scripts/http-cache-semantics.test.mjs"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.10",
        "@astrojs/mdx": "8.0.2",
        "@eslint/js": "10.0.1",
        "@pagefind/default-ui": "1.5.2",
        "@tailwindcss/vite": "4.3.3",
        "astro": "7.3.5",
        "eslint": "10.11.0",
        "eslint-plugin-astro": "3.2.1",
        "marked": "18.0.14",
        "pagefind": "1.5.2",
        "prettier": "3.9.9",
        "prettier-plugin-astro": "1.1.0",
        "sharp": "0.35.5",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.0",
        "vite": "8.3.1",
        "vitest": "5.0.2",
        "zod": "4.6.5"
    },
    "dependencies": {
        "@modrex/games": "workspace:*",
        "@modrex/scrollbars": "workspace:*",
        "@astrojs/sitemap": "3.7.4",
        "@astrojs/starlight": "0.42.4",
        "lucide": "1.48.0"
    }
}
