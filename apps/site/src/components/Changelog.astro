---
import { marked } from 'marked'
import type { Release } from '../lib/github'

interface Props {
    releases: Release[]
}
const { releases } = Astro.props

// UTC so the rendered date doesn't depend on the build machine's timezone.
const dateFormat = new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
})

// Release bodies are Modrex's own CHANGELOG.md sections (stamped into the release
// by the CI workflow), so rendering them with set:html is trusted build-time content.
const entries = releases.map((release) => ({
    version: release.tag_name,
    publishedAt: release.published_at,
    date: dateFormat.format(new Date(release.published_at)),
    url: release.html_url,
    html: marked.parse(release.body, { async: false }),
}))
---

{
    entries.length > 0 && (
        <section id="changelog">
            <div class="wrap">
                <div class="sec-head">
                    <h2 class="sec-title">Changelog</h2>
                    <a
                        class="all-releases"
                        href="https://github.com/modrexio/modrex/releases"
                        target="_blank"
                        rel="noopener"
                    >
                        All releases on GitHub
                    </a>
                </div>
                {entries.map((entry) => (
                    <article class="release">
                        <header>
                            <a class="rel-version" href={entry.url} target="_blank" rel="noopener">
                                {entry.version}
                            </a>
                            <time class="rel-date" datetime={entry.publishedAt}>
                                {entry.date}
                            </time>
                        </header>
                        <div class="rel-body" set:html={entry.html} />
                    </article>
                ))}
            </div>
        </section>
    )
}

<style>
    .all-releases {
        margin-left: auto;
        font-size: 14px;
        color: var(--text-secondary);
    }

    .all-releases:hover {
        color: var(--color-text);
    }

    .release {
        display: grid;
        grid-template-columns: 200px minmax(0, 1fr);
        gap: 32px;
        padding: 28px 0;
        border-top: 1px solid var(--color-border);
    }

    .rel-version {
        display: block;
        font-size: 15px;
        font-weight: 600;
        color: var(--color-text);
    }

    .rel-version:hover {
        color: var(--color-accent-bright);
    }

    .rel-date {
        display: block;
        margin-top: 2px;
        font-size: 13px;
        color: var(--text-tertiary);
    }

    .rel-body :global(h3) {
        margin: 20px 0 6px;
        font-size: 13px;
        font-weight: 600;
        color: var(--color-text);
    }

    .rel-body :global(h3:first-child) {
        margin-top: 0;
    }

    /* Tailwind preflight resets list-style to none, so restore the markers. */
    .rel-body :global(ul) {
        margin: 0;
        padding-left: 18px;
        list-style: disc;
    }

    .rel-body :global(ul ul) {
        list-style: circle;
    }

    .rel-body :global(li) {
        margin: 4px 0;
        font-size: 14px;
        line-height: 1.55;
        color: var(--text-secondary);
    }

    .rel-body :global(li::marker) {
        color: var(--color-surface-light);
    }

    .rel-body :global(code) {
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--color-text);
        background: var(--color-surface-hover);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        padding: 1px 5px;
    }

    @media (max-width: 640px) {
        .release {
            grid-template-columns: minmax(0, 1fr);
            gap: 12px;
            padding: 24px 0;
        }
    }
</style>
