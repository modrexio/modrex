---
import type { Release } from '../lib/github'

interface Props {
    release: Release | null
}
const { release } = Astro.props

function formatSize(bytes: number): string {
    const mb = bytes / (1024 * 1024)
    return mb >= 1 ? `${mb.toFixed(1)} MB` : `${(bytes / 1024).toFixed(0)} KB`
}

type DlFile = { name: string; url: string; size?: string }

const exeAsset = release?.assets.find((a) => a.name.endsWith('.exe'))
const appImageAsset = release?.assets.find((a) => a.name === 'modrex_x86_64.AppImage')
const debAsset = release?.assets.find((a) => a.name === 'modrex_x86_64.deb')
const rpmAsset = release?.assets.find((a) => a.name === 'modrex_x86_64.rpm')

const fallbackUrl = 'https://github.com/modrexio/modrex/releases/latest'
const installCmd = 'curl -fsSL https://modrex.net/install.sh | sh'
// The published winget manifest sets Moniker: modrex, so the short name resolves
// without the Modrexio.Modrex identifier.
const wingetCmd = 'winget install modrex'

const windowsFiles: DlFile[] = exeAsset
    ? [
          {
              name: exeAsset.name,
              url: exeAsset.browser_download_url,
              size: formatSize(exeAsset.size),
          },
      ]
    : [{ name: 'modrex_x86_64.exe', url: fallbackUrl }]

const linuxFiles: DlFile[] = [
    appImageAsset
        ? {
              name: appImageAsset.name,
              url: appImageAsset.browser_download_url,
              size: formatSize(appImageAsset.size),
          }
        : { name: 'modrex_x86_64.AppImage', url: fallbackUrl },
    debAsset
        ? {
              name: debAsset.name,
              url: debAsset.browser_download_url,
              size: formatSize(debAsset.size),
          }
        : { name: 'modrex_x86_64.deb', url: fallbackUrl },
    rpmAsset
        ? {
              name: rpmAsset.name,
              url: rpmAsset.browser_download_url,
              size: formatSize(rpmAsset.size),
          }
        : { name: 'modrex_x86_64.rpm', url: fallbackUrl },
]

const extension = (file: DlFile) => file.name.split('.').pop()
---

<section id="download">
    <div class="wrap">
        <div class="sec-head">
            <h2 class="sec-title">Download</h2>
        </div>
        <p class="sec-sub">Modrex updates itself after the first install.</p>

        <div class="dl-table">
            <div class="dl-row">
                <h3 class="os">
                    <img src="/icons/windows-white.svg" alt="" width="20" height="20" />
                    Windows
                </h3>
                <div class="dl-body">
                    <div class="files">
                        {windowsFiles.map((f) => (
                            <a class="btn-lg primary dl-btn" href={f.url} data-os-main="windows">
                                Download .{extension(f)}{' '}
                                {f.size && <span class="fsize">{f.size}</span>}
                            </a>
                        ))}
                    </div>
                    <p class="cli-label">Or with winget</p>
                    <div class="quick-install">
                        <code>
                            <span class="tok-cmd">winget</span> install modrex
                        </code>
                        <button
                            class="copy-btn"
                            data-cmd={wingetCmd}
                            aria-label="Copy winget install command"
                        >
                            <i data-lucide="copy"></i>
                            <i data-lucide="check" style="display: none"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="dl-row">
                <h3 class="os">
                    <img src="/icons/linux-white.svg" alt="" width="20" height="20" />
                    Linux
                </h3>
                <div class="dl-body">
                    <div class="files">
                        {linuxFiles.map((f, i) => (
                            <a
                                class="btn-lg secondary dl-btn"
                                href={f.url}
                                data-os-main={i === 0 ? 'linux' : undefined}
                            >
                                Download .{extension(f)}{' '}
                                {f.size && <span class="fsize">{f.size}</span>}
                            </a>
                        ))}
                    </div>
                    <p class="cli-label">Or with the install script</p>
                    <div class="quick-install">
                        <code>
                            <span class="tok-cmd">curl</span> -fsSL https://modrex.net/install.sh{' '}
                            <span class="tok-pipe">|</span> <span class="tok-cmd">sh</span>
                        </code>
                        <button
                            class="copy-btn"
                            data-cmd={installCmd}
                            aria-label="Copy install command"
                        >
                            <i data-lucide="copy"></i>
                            <i data-lucide="check" style="display: none"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <p class="dl-note">
            Works with Steam, Epic Games and the Xbox app on Windows, and Steam on Linux. See the{' '}
            <a href="/docs/getting-started">installation guide</a>.
        </p>
    </div>
</section>

<script>
    import { createIcons, Check, Copy } from 'lucide'
    import { detectOs } from '../lib/os-detect'
    createIcons({ icons: { Check, Copy } })

    document.querySelectorAll<HTMLElement>('.copy-btn').forEach((copyBtn) => {
        copyBtn.addEventListener('click', async () => {
            const cmd = copyBtn.dataset.cmd
            if (!cmd) return
            await navigator.clipboard.writeText(cmd)
            const [copyIcon, checkIcon] = copyBtn.querySelectorAll<SVGElement>('svg')
            if (copyIcon && checkIcon) {
                copyIcon.style.display = 'none'
                checkIcon.style.display = ''
                setTimeout(() => {
                    copyIcon.style.display = ''
                    checkIcon.style.display = 'none'
                }, 1500)
            }
        })
    })

    // Windows is the filled button in the markup. A desktop Linux visitor gets the
    // AppImage filled instead, so there is only ever one primary download.
    const { isMobile, isLinux } = detectOs()
    if (!isMobile && isLinux) {
        document.querySelectorAll<HTMLElement>('[data-os-main]').forEach((button) => {
            const main = button.dataset.osMain === 'linux'
            button.classList.toggle('primary', main)
            button.classList.toggle('secondary', !main)
        })
    }
</script>

<style>
    /* Both platforms share the middle column, which is as wide as the widest row of
       download buttons, so every command box ends where that button row ends. */
    .dl-table {
        display: grid;
        grid-template-columns: 200px minmax(0, max-content) 1fr;
        column-gap: 32px;
    }

    .dl-row {
        display: grid;
        grid-column: 1 / -1;
        grid-template-columns: subgrid;
        padding: 28px 0;
        border-top: 1px solid var(--color-border);
    }

    .dl-row + .dl-row {
        border-bottom: 1px solid var(--color-border);
    }

    .os {
        display: flex;
        align-items: center;
        gap: 12px;
        height: 42px;
        margin: 0;
        font-size: 17px;
        font-weight: 600;
    }

    .files {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .dl-btn {
        padding: 10px 16px;
        font-size: 14px;
    }

    .dl-btn.secondary {
        font-weight: 500;
    }

    .fsize {
        font-weight: 400;
        color: rgba(255, 255, 255, 0.72);
    }

    .dl-btn.secondary .fsize {
        color: var(--text-tertiary);
    }

    .cli-label {
        margin: 20px 0 8px;
        font-size: 13px;
        color: var(--text-tertiary);
    }

    .quick-install {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--color-surface-raised);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        padding: 6px 6px 6px 14px;
    }

    .quick-install code {
        flex: 1;
        min-width: 0;
        font-family: var(--font-mono);
        font-size: 13px;
        line-height: 1.7;
        color: var(--color-text);
        word-break: break-all;
    }

    /* Same scheme as the docs code blocks (modrexCodeTheme in astro.config.mjs):
       commands accent-bright, operators muted, arguments primary text. */
    .quick-install .tok-cmd {
        color: var(--color-accent-bright);
    }

    .quick-install .tok-pipe {
        color: var(--color-text-muted);
    }

    .copy-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: var(--copy-btn-size);
        height: var(--copy-btn-size);
        background: transparent;
        border: none;
        border-radius: var(--radius-sm);
        color: var(--text-tertiary);
        cursor: pointer;
        transition: var(--transition-colors);
    }

    .copy-btn:hover {
        color: var(--color-text);
        background: var(--color-surface-hover);
    }

    .copy-btn svg {
        width: var(--copy-btn-icon);
        height: var(--copy-btn-icon);
    }

    .dl-note {
        margin: 20px 0 0;
        font-size: 14px;
        color: var(--text-tertiary);
    }

    @media (max-width: 640px) {
        .dl-table {
            grid-template-columns: minmax(0, 1fr);
        }

        .dl-row {
            row-gap: 16px;
            padding: 24px 0;
        }

        .os {
            height: auto;
        }

        .dl-btn {
            flex: 1 1 100%;
            min-height: 44px;
        }

        .quick-install {
            padding-left: 12px;
        }
    }
</style>
