---
import { Picture } from 'astro:assets'
import type { ModIndexStats } from '../lib/mod-index'
import type { NexusModCounts } from '../lib/nexus-mod-count'
import browseMods from '../assets/screenshots/browse-mods-window.webp'
import installedMods from '../assets/screenshots/installed-mods-window.webp'
import Sketch from './Sketch.astro'

interface Props {
    indexStats: ModIndexStats | null
    nexusModCounts: NexusModCounts | null
}

const { indexStats, nexusModCounts } = Astro.props
const supportedMods = indexStats
    ? new Intl.NumberFormat('en-US').format(indexStats.supportedMods)
    : null
// A separate claim from supportedMods, deliberately not summed into it: this counts
// mods that EXIST on Nexus, not mods Modrex can recognize by hash on your disk.
const nexusModsAvailable = nexusModCounts
    ? new Intl.NumberFormat('en-US').format(nexusModCounts.total)
    : null

// Each crop is a window onto a full 2560x1368 screenshot, in source pixels, so the
// evidence stays in sync with the screenshots instead of living in separate files.
// The image is scaled up by 2560 / w and shifted so the rectangle fills the frame.
const SOURCE_WIDTH = 2560
const CROP_WIDTHS = [1180, 1706, 2560]

function crop(x: number, y: number, w: number, h: number) {
    const scale = SOURCE_WIDTH / w
    // The frame is 7/12 of the content column beside the text (775px at the full
    // 1440px wrap), and the whole column below 900px. The image renders scale
    // times wider than its frame.
    return {
        frameStyle: `aspect-ratio: ${w} / ${h}`,
        imgStyle: `width: ${scale * 100}%; left: ${(-x / w) * 100}%; top: ${(-y / h) * 100}%`,
        sizes: [
            `(max-width: 768px) calc((100vw - 32px) * ${scale})`,
            `(max-width: 900px) calc((100vw - 64px) * ${scale})`,
            `(max-width: 1440px) calc((100vw - 112px) * 7 / 12 * ${scale})`,
            `${Math.round(775 * scale)}px`,
        ].join(', '),
    }
}

const launchCrop = crop(1760, 0, 800, 156)
const browseCrop = crop(300, 70, 1120, 600)
const installedCrop = crop(300, 242, 1120, 600)
---

<section id="features">
    <div class="wrap">
        <div class="sec-head">
            <h2 class="sec-title">Features</h2>
        </div>

        <div class="rows">
            <div class="row art">
                <div class="row-text">
                    <h3>From mod page to game</h3>
                    <p>
                        Find a mod on ModWorkshop or Nexus Mods, install it, switch it on and start
                        the game, modded or vanilla.
                    </p>
                </div>
                <Sketch name="mod-route" />
            </div>

            <div class="row">
                <div class="row-text">
                    <h3>Launch modded or vanilla</h3>
                    <p>
                        Launch with enabled mods or use Launch without mods. Ready or Not uses Safe
                        Mode for Pak mods. Other games temporarily hide managed mods and restore
                        them when the game exits.
                    </p>
                </div>
                <div class="crop" style={launchCrop.frameStyle}>
                    <Picture
                        src={installedMods}
                        alt="The Launch without mods and Launch modded buttons in the Modrex top bar"
                        widths={CROP_WIDTHS}
                        sizes={launchCrop.sizes}
                        formats={['avif']}
                        fallbackFormat="webp"
                        loading="lazy"
                        style={launchCrop.imgStyle}
                    />
                </div>
            </div>

            <div class="row">
                <div class="row-text">
                    <h3>ModWorkshop and Nexus Mods in one place</h3>
                    <p>
                        Search both sites with categories, tags and sorting, read the mod page, and
                        install from the result.{' '}
                        {nexusModsAvailable && (
                            <span>Nexus lists {nexusModsAvailable} mods for these games.</span>
                        )}
                    </p>
                </div>
                <div class="crop" style={browseCrop.frameStyle}>
                    <Picture
                        src={browseMods}
                        alt="Browsing ModWorkshop mods in Modrex, with Install buttons on each result"
                        widths={CROP_WIDTHS}
                        sizes={browseCrop.sizes}
                        formats={['avif']}
                        fallbackFormat="webp"
                        loading="lazy"
                        style={browseCrop.imgStyle}
                    />
                </div>
            </div>

            <div class="row art">
                <div class="row-text">
                    <h3>One archive, one mod</h3>
                    <p>
                        Pak mods often ship as .pak, .utoc and .ucas files inside a .zip or .7z.
                        Modrex keeps them together as one mod you switch on and off.
                    </p>
                </div>
                <Sketch name="archive-unpack" />
            </div>

            <div class="row">
                <div class="row-text">
                    <h3>Recognizes mods you already have</h3>
                    <p>
                        Modrex matches the files in your game folder against{' '}
                        <strong data-mod-index-count aria-live="polite">
                            {supportedMods ?? '...'}
                        </strong>{' '}
                        known mods, so mods you installed by hand are detected too.
                    </p>
                </div>
                <div class="crop" style={installedCrop.frameStyle}>
                    <Picture
                        src={installedMods}
                        alt="The Modrex installed mods list, each mod with its own switch"
                        widths={CROP_WIDTHS}
                        sizes={installedCrop.sizes}
                        formats={['avif']}
                        fallbackFormat="webp"
                        loading="lazy"
                        style={installedCrop.imgStyle}
                    />
                </div>
            </div>
        </div>

        <ul class="also">
            <li>
                <strong>Archives</strong> in .pak, .zip, .7z, .rar, .tar.gz and .tar.xz, with
                multi-file mods kept together
            </li>
            <li>
                <strong>Folders</strong> of any depth, reordered by dragging
            </li>
            <li>
                <strong>Update checks</strong> for one mod or all of them at once
            </li>
            <li>
                <strong>Game detection</strong> across launchers, including mods added outside
                Modrex
            </li>
        </ul>
    </div>
</section>

<script>
    import { INDEX_STATS_URL, type ModIndexStatsPayload } from '../lib/mod-index-shared'

    const countEl = document.querySelector<HTMLElement>('[data-mod-index-count]')

    async function refreshModIndexCount() {
        if (!countEl) return

        const cacheKey = Math.floor(Date.now() / 60_000)
        const res = await fetch(`${INDEX_STATS_URL}?t=${cacheKey}`, { cache: 'no-store' })

        if (!res.ok) throw new Error(`Index stats download error: ${res.status}`)

        const stats = (await res.json()) as ModIndexStatsPayload

        const supportedMods = stats.stats?.supportedMods
        if (
            typeof supportedMods === 'number' &&
            Number.isFinite(supportedMods) &&
            supportedMods > 0
        ) {
            countEl.textContent = new Intl.NumberFormat('en-US').format(supportedMods)
        }
    }

    refreshModIndexCount().catch((error: unknown) => {
        console.error('Failed to refresh mod index count', error)
    })
</script>

<style>
    .rows {
        display: flex;
        flex-direction: column;
        gap: 56px;
    }

    .row {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        gap: 48px;
        align-items: center;
    }

    .row.art > :global(.sketch) {
        order: -1;
    }

    .row-text h3 {
        margin: 0 0 8px;
        font-size: 20px;
        font-weight: 600;
        line-height: 1.3;
    }

    .row-text p {
        margin: 0;
        max-width: 44ch;
        font-size: 15px;
        line-height: 1.6;
        color: var(--text-secondary);
    }

    .row-text strong {
        color: var(--color-text);
        font-weight: 600;
    }

    .crop {
        position: relative;
        overflow: hidden;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        background: var(--color-surface-raised);
    }

    .crop :global(img) {
        position: absolute;
        display: block;
        max-width: none;
        height: auto;
    }

    .also {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px 48px;
        margin: 64px 0 0;
        padding: 0;
        list-style: none;
    }

    .also li {
        position: relative;
        padding-left: 16px;
        font-size: 15px;
        line-height: 1.6;
        color: var(--text-secondary);
    }

    .also li::before {
        content: '';
        position: absolute;
        top: 0.8em;
        left: 0;
        width: 6px;
        height: 1px;
        background: var(--color-surface-light);
    }

    .also strong {
        color: var(--color-text);
        font-weight: 600;
    }

    @media (max-width: 900px) {
        .row {
            grid-template-columns: minmax(0, 1fr);
            gap: 20px;
        }

        .row.art > :global(.sketch) {
            order: 0;
        }

        .rows {
            gap: 48px;
        }
    }

    @media (max-width: 640px) {
        .also {
            grid-template-columns: minmax(0, 1fr);
            margin-top: 48px;
        }
    }
</style>
