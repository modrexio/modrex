---
import { Picture } from 'astro:assets'
import type { Release } from '../lib/github'
import gamePicker from '../assets/screenshots/game-picker-window.png'
import browseMods from '../assets/screenshots/browse-mods-window.png'
import installedMods from '../assets/screenshots/installed-mods-window.png'
import news from '../assets/screenshots/news-window.png'
import settings from '../assets/screenshots/settings-window.png'

interface Props {
    release?: Release | null
}

const { release = null } = Astro.props

// Imported rather than served from public/ so astro:assets emits AVIF and WebP at
// several widths. The sources are 1706px PNG screenshots, about a megabyte each; the
// first one shown is the largest contentful paint of the whole site.
const shots = [
    {
        src: gamePicker,
        name: 'Game picker',
        alt: 'Choosing a game in Modrex: PAYDAY 3, PAYDAY 2, PAYDAY: The Heist, Crime Boss and RAID',
        desc: 'Pick the game you want to mod.',
    },
    {
        src: browseMods,
        name: 'Browse mods',
        alt: 'Browsing ModWorkshop and Nexus Mods inside Modrex',
        desc: 'ModWorkshop and Nexus Mods side by side, with categories, tags and sorting.',
    },
    {
        src: installedMods,
        name: 'Installed',
        alt: 'The Modrex installed mods list, each mod with its own switch',
        desc: 'Every installed mod, each with its own on and off switch.',
    },
    {
        src: news,
        name: 'News',
        alt: 'The Modrex news tab showing the latest posts for the active game',
        desc: 'The latest posts for the game you picked.',
    },
    {
        src: settings,
        name: 'Settings',
        alt: 'Modrex application settings: language, accent color, updates, usage analytics and Discord Rich Presence',
        desc: 'Language, accent color, updates, analytics and Discord presence.',
    },
]

// Browse mods opens first: the game picker is a mostly empty window, and the stage
// should lead with the screen that shows what the app is for.
const FIRST = 1

// The stage is 7/12 of the content column beside the hero text (775px at the full
// 1440px wrap), and the whole column once the hero stacks below 1100px.
const STAGE_WIDTHS = [640, 1180, 1706]
const STAGE_SIZES = [
    '(max-width: 768px) calc(100vw - 32px)',
    '(max-width: 1100px) calc(100vw - 64px)',
    '(max-width: 1440px) calc((100vw - 112px) * 7 / 12)',
    '775px',
].join(', ')
const VIEWER_WIDTHS = [1180, 1706]

const releasedOn = release
    ? new Intl.DateTimeFormat('en-US', {
          month: 'short',
          day: 'numeric',
          year: 'numeric',
          timeZone: 'UTC',
      }).format(new Date(release.published_at))
    : null
---

<header class="hero">
    <div class="wrap hero-grid">
        <div class="hero-text">
            <h1 class="hero-title">Modrex <span class="nowrap">Mod Manager</span></h1>
            <p class="hero-sub">
                Browse ModWorkshop and Nexus Mods, install in one click, and launch the game modded
                or vanilla from the same window.
            </p>
            <div class="cta-row">
                <a href="/#download" id="hero-dl" class="btn-lg primary">
                    <img
                        id="hero-dl-icon"
                        src="/icons/windows-white.svg"
                        alt=""
                        width="16"
                        height="16"
                    />
                    <span id="hero-dl-label">Download for Windows</span>
                </a>
                <a href="/#download" id="hero-other" class="other-link">Linux and other downloads</a
                >
            </div>
            <p class="hero-meta">
                Free and open source.{' '}
                {
                    release && (
                        <span>
                            <a href={release.html_url} target="_blank" rel="noopener">
                                {release.tag_name}
                            </a>
                            <span>, released {releasedOn}.</span>
                        </span>
                    )
                }
            </p>
        </div>

        <div class="stage" id="screenshots">
            <div
                class="stage-frame"
                id="stage-panel"
                role="tabpanel"
                aria-labelledby={`shot-tab-${FIRST}`}
            >
                <button
                    type="button"
                    class="stage-open"
                    id="stage-open"
                    aria-label={`Open ${shots[FIRST].name} fullscreen`}
                >
                    <span class="shot-stack">
                        {
                            shots.map((s, i) => (
                                <span class:list={['stage-shot', { active: i === FIRST }]}>
                                    <Picture
                                        src={s.src}
                                        alt={s.alt}
                                        widths={STAGE_WIDTHS}
                                        sizes={STAGE_SIZES}
                                        formats={['avif']}
                                        fallbackFormat="webp"
                                        loading={i === FIRST ? 'eager' : 'lazy'}
                                        fetchpriority={i === FIRST ? 'high' : 'auto'}
                                    />
                                </span>
                            ))
                        }
                    </span>
                </button>
                <div class="stage-bar">
                    <span class="shot-name" data-shot-name>{shots[FIRST].name}</span>
                    <span class="shot-count" data-shot-count>{FIRST + 1} / {shots.length}</span>
                    <div class="seg">
                        <button type="button" data-step="-1" aria-label="Previous screenshot">
                            <i data-lucide="chevron-left"></i>
                        </button>
                        <button type="button" data-step="1" aria-label="Next screenshot">
                            <i data-lucide="chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="stage-tabs">
                <div class="tablist" role="tablist" aria-label="Screenshots">
                    {
                        shots.map((s, i) => (
                            <button
                                type="button"
                                role="tab"
                                id={`shot-tab-${i}`}
                                class:list={['tab', { active: i === FIRST }]}
                                aria-controls="stage-panel"
                                aria-selected={i === FIRST ? 'true' : 'false'}
                                tabindex={i === FIRST ? 0 : -1}
                                data-desc={s.desc}
                            >
                                {s.name}
                            </button>
                        ))
                    }
                </div>
                <button type="button" class="fullscreen" id="stage-fullscreen">
                    <i data-lucide="maximize-2"></i>
                    Fullscreen
                </button>
            </div>
            <p class="stage-desc" data-shot-desc>{shots[FIRST].desc}</p>
        </div>
    </div>

    <dialog class="viewer" id="viewer" aria-label="Screenshot viewer">
        <div class="viewer-bar">
            <span class="shot-name" data-shot-name>{shots[FIRST].name}</span>
            <span class="shot-count" data-shot-count>{FIRST + 1} / {shots.length}</span>
            <div class="viewer-actions">
                <div class="seg">
                    <button type="button" data-step="-1" aria-label="Previous screenshot">
                        <i data-lucide="chevron-left"></i>
                    </button>
                    <button type="button" data-step="1" aria-label="Next screenshot">
                        <i data-lucide="chevron-right"></i>
                    </button>
                </div>
                <button type="button" class="viewer-close" id="viewer-close" autofocus>
                    <i data-lucide="x"></i>
                    Close
                    <kbd>Esc</kbd>
                </button>
            </div>
        </div>
        <div class="viewer-body" id="viewer-body">
            {
                shots.map((s, i) => (
                    <div class:list={['viewer-shot', { active: i === FIRST }]}>
                        <Picture
                            src={s.src}
                            alt={s.alt}
                            widths={VIEWER_WIDTHS}
                            sizes="100vw"
                            formats={['avif']}
                            fallbackFormat="webp"
                            loading="lazy"
                        />
                    </div>
                ))
            }
        </div>
    </dialog>
</header>

<script>
    import { createIcons, ChevronLeft, ChevronRight, Maximize2, X } from 'lucide'
    import { detectOs } from '../lib/os-detect'

    createIcons({ icons: { ChevronLeft, ChevronRight, Maximize2, X } })

    const { isMobile, isLinux } = detectOs()
    const label = document.getElementById('hero-dl-label')
    const icon = document.getElementById('hero-dl-icon') as HTMLImageElement | null
    const other = document.getElementById('hero-other')
    if (isMobile) {
        if (label) label.textContent = 'Download'
        if (icon) icon.style.display = 'none'
        if (other) other.textContent = 'Downloads'
    } else if (isLinux) {
        if (label) label.textContent = 'Download for Linux'
        if (icon) icon.src = '/icons/linux-white.svg'
        if (other) other.textContent = 'Windows and other downloads'
    }

    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tablist [role="tab"]'))
    const stageShots = Array.from(document.querySelectorAll<HTMLElement>('.stage-shot'))
    const viewerShots = Array.from(document.querySelectorAll<HTMLElement>('.viewer-shot'))
    const panel = document.getElementById('stage-panel')!
    const openButton = document.getElementById('stage-open')!
    const viewer = document.getElementById('viewer') as HTMLDialogElement
    let index = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true')

    function show(next: number) {
        index = (next + tabs.length) % tabs.length
        const name = tabs[index].textContent?.trim() ?? ''
        stageShots.forEach((shot, i) => shot.classList.toggle('active', i === index))
        viewerShots.forEach((shot, i) => shot.classList.toggle('active', i === index))
        tabs.forEach((tab, i) => {
            const selected = i === index
            tab.classList.toggle('active', selected)
            tab.setAttribute('aria-selected', String(selected))
            tab.tabIndex = selected ? 0 : -1
        })
        document.querySelectorAll('[data-shot-name]').forEach((el) => (el.textContent = name))
        document
            .querySelectorAll('[data-shot-count]')
            .forEach((el) => (el.textContent = `${index + 1} / ${tabs.length}`))
        document
            .querySelectorAll('[data-shot-desc]')
            .forEach((el) => (el.textContent = tabs[index].dataset.desc ?? ''))
        panel.setAttribute('aria-labelledby', tabs[index].id)
        openButton.setAttribute('aria-label', `Open ${name} fullscreen`)
    }

    tabs.forEach((tab, i) => tab.addEventListener('click', () => show(i)))
    document.querySelector<HTMLElement>('.tablist')!.addEventListener('keydown', (event) => {
        const targets: Record<string, number> = {
            ArrowLeft: index - 1,
            ArrowRight: index + 1,
            Home: 0,
            End: -1,
        }
        const target = targets[event.key]
        if (target === undefined) return
        event.preventDefault()
        show(target)
        tabs[index].focus()
    })
    document
        .querySelectorAll<HTMLButtonElement>('[data-step]')
        .forEach((button) =>
            button.addEventListener('click', () => show(index + Number(button.dataset.step)))
        )

    // Horizontal swipes step through the screenshots. Anything more vertical than
    // horizontal is left alone so the page still scrolls.
    function onSwipe(el: HTMLElement) {
        let startX = 0
        let startY = 0
        el.addEventListener(
            'touchstart',
            (event) => {
                startX = event.touches[0].clientX
                startY = event.touches[0].clientY
            },
            { passive: true }
        )
        el.addEventListener('touchend', (event) => {
            const dx = event.changedTouches[0].clientX - startX
            const dy = event.changedTouches[0].clientY - startY
            if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return
            show(index + (dx < 0 ? 1 : -1))
        })
    }
    onSwipe(panel)
    onSwipe(document.getElementById('viewer-body')!)

    // showModal makes the rest of the page inert and closes on Escape. Focus goes
    // back to whatever opened the viewer, since not every browser restores it.
    let opener: HTMLElement | null = null
    function openViewer() {
        opener = document.activeElement as HTMLElement | null
        viewer.showModal()
    }
    viewer.addEventListener('close', () => opener?.focus())
    openButton.addEventListener('click', openViewer)
    document.getElementById('stage-fullscreen')!.addEventListener('click', openViewer)
    document.getElementById('viewer-close')!.addEventListener('click', () => viewer.close())
    document.getElementById('viewer-body')!.addEventListener('click', (event) => {
        if (event.target === event.currentTarget) viewer.close()
    })
    viewer.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') show(index - 1)
        if (event.key === 'ArrowRight') show(index + 1)
    })
</script>

<style>
    .hero {
        padding: 64px 0 0;
    }

    .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        gap: 48px;
        align-items: center;
    }

    .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        gap: 48px;
        align-items: center;
    }

    .hero-title {
        margin: 0 0 20px;
        font-family: var(--font-display);
        font-size: clamp(48px, 4.4vw, 64px);
        font-weight: 400;
        font-synthesis: none;
        line-height: 0.95;
        letter-spacing: 0.01em;
        text-wrap: balance;
    }

    .nowrap {
        white-space: nowrap;
    }

    .hero-sub {
        margin: 0;
        max-width: 46ch;
        font-size: 17px;
        line-height: 1.6;
        color: var(--text-secondary);
    }

    .cta-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px 20px;
        margin-top: 24px;
    }

    .other-link {
        font-size: 14px;
        color: var(--text-secondary);
        border-bottom: 1px solid var(--color-border);
        padding-bottom: 1px;
    }

    .other-link:hover {
        color: var(--color-text);
        border-color: var(--color-surface-light);
    }

    .hero-meta {
        margin: 14px 0 0;
        font-size: 13px;
        color: var(--text-tertiary);
    }

    .hero-meta a {
        color: var(--text-secondary);
    }

    .hero-meta a:hover {
        color: var(--color-text);
    }

    .stage {
        min-width: 0;
        scroll-margin-top: 80px;
    }

    .stage-frame {
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        background: var(--color-surface-raised);
    }

    .stage-open {
        display: block;
        width: 100%;
        padding: 0;
        border: 0;
        background: none;
        cursor: zoom-in;
    }

    .stage-open:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: -2px;
    }

    /* Every screenshot shares one grid cell, so switching crossfades in place and
       the frame never changes height. Hidden ones still lazy-load once the stage is
       near. visibility waits for the fade, which keeps the outgoing shot on screen
       until it has faded and out of the tab order afterwards. */
    .shot-stack {
        display: grid;
    }

    .stage-shot,
    .viewer-shot {
        grid-area: 1 / 1;
        visibility: hidden;
        opacity: 0;
        transition:
            opacity var(--duration) var(--ease),
            visibility 0s linear var(--duration);
    }

    .stage-shot.active,
    .viewer-shot.active {
        visibility: visible;
        opacity: 1;
        transition-delay: 0s;
    }

    .stage-shot :global(picture),
    .stage-shot :global(img) {
        display: block;
        width: 100%;
        height: auto;
    }

    .stage-tabs {
        display: flex;
        align-items: flex-end;
        border-bottom: 1px solid var(--color-border);
    }

    .tablist {
        display: flex;
        gap: 4px;
    }

    .tab {
        padding: 12px 12px 11px;
        margin-bottom: -1px;
        border: 0;
        border-bottom: 2px solid transparent;
        background: none;
        font: inherit;
        font-size: 13px;
        color: var(--text-tertiary);
        white-space: nowrap;
        transition: var(--transition-colors);
    }

    .tab:hover {
        color: var(--text-secondary);
    }

    .tab.active {
        color: var(--color-accent-bright);
        border-bottom-color: var(--color-accent);
    }

    .tab:focus-visible,
    .fullscreen:focus-visible,
    .seg button:focus-visible,
    .viewer-close:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: -2px;
    }

    .fullscreen {
        display: flex;
        align-items: center;
        gap: 8px;
        height: 32px;
        margin: 0 0 6px auto;
        padding: 0 10px;
        border: 0;
        border-radius: var(--radius-sm);
        background: none;
        font: inherit;
        font-size: 13px;
        color: var(--text-secondary);
        transition: var(--transition-colors);
    }

    .fullscreen:hover {
        background: var(--color-surface-hover);
        color: var(--color-text);
    }

    .fullscreen i,
    .fullscreen svg,
    .seg i,
    .seg svg,
    .viewer-close i,
    .viewer-close svg {
        display: block;
        width: 16px;
        height: 16px;
    }

    .stage-desc {
        margin: 12px 0 0;
        font-size: 14px;
        color: var(--text-secondary);
    }

    .stage-bar {
        display: none;
        align-items: center;
        gap: 12px;
        min-height: 56px;
        padding: 0 6px 0 14px;
        border-top: 1px solid var(--color-border);
    }

    .shot-name {
        font-size: 14px;
        font-weight: 600;
        color: var(--color-text);
        white-space: nowrap;
    }

    .shot-count {
        font-size: 12px;
        color: var(--text-tertiary);
        font-variant-numeric: tabular-nums;
    }

    .stage-bar .shot-count {
        flex: 1;
    }

    .seg {
        display: flex;
        flex: none;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        overflow: hidden;
        background: var(--color-surface-hover);
    }

    .seg button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 32px;
        padding: 0;
        border: 0;
        background: none;
        color: var(--text-secondary);
        transition: var(--transition-colors);
    }

    .seg button + button {
        border-left: 1px solid var(--color-border);
    }

    .seg button:hover {
        background: var(--color-surface-active);
        color: var(--color-text);
    }

    /* The page stays locked while the viewer is open. html, not body, has to hold
       the lock because html clips its own overflow, which stops body's overflow
       from reaching the window. The gutter keeps the page from shifting when the
       scrollbar goes away. */
    :global(html) {
        scrollbar-gutter: stable;
    }

    :global(html:has(dialog.viewer[open])) {
        overflow: hidden;
    }

    /* An overlay over the page rather than a new page: the same 90 percent black the
       app's own image lightbox uses. It fades in and out, and display and overlay
       are held until the fade ends so closing animates too. */
    .viewer {
        width: 100%;
        max-width: none;
        height: 100%;
        max-height: none;
        margin: 0;
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--color-text);
        opacity: 0;
        transition:
            opacity var(--duration) var(--ease),
            overlay var(--duration) allow-discrete,
            display var(--duration) allow-discrete;
    }

    .viewer[open] {
        display: flex;
        flex-direction: column;
        opacity: 1;
    }

    .viewer::backdrop {
        background: rgba(0, 0, 0, 0.9);
        opacity: 0;
        transition:
            opacity var(--duration) var(--ease),
            overlay var(--duration) allow-discrete,
            display var(--duration) allow-discrete;
    }

    .viewer[open]::backdrop {
        opacity: 1;
    }

    @starting-style {
        .viewer[open],
        .viewer[open]::backdrop {
            opacity: 0;
        }
    }

    /* Solid, unlike the rest of the overlay: the page's own nav sits directly behind
       this bar, and through the translucent overlay its links read as part of it. */
    .viewer-bar {
        display: flex;
        align-items: center;
        gap: 14px;
        flex: none;
        height: 52px;
        padding: 0 12px 0 20px;
        background: var(--color-surface);
        border-bottom: 1px solid var(--color-border);
    }

    .viewer-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-left: auto;
    }

    .viewer-close {
        display: flex;
        align-items: center;
        gap: 8px;
        height: 32px;
        padding: 0 10px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        background: var(--color-surface-hover);
        font: inherit;
        font-size: 13px;
        color: var(--color-text);
        transition: var(--transition-colors);
    }

    .viewer-close:hover {
        background: var(--color-surface-active);
    }

    .viewer-close kbd {
        padding: 1px 5px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-tertiary);
    }

    .viewer-body {
        display: grid;
        flex: 1;
        min-height: 0;
        padding: 24px;
        place-items: center;
        cursor: zoom-out;
    }

    .viewer-shot {
        cursor: default;
    }

    .viewer-shot :global(picture) {
        display: block;
    }

    .viewer-shot :global(img) {
        display: block;
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: calc(100dvh - 52px - 48px);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
    }

    /* With text and gallery side by side, the hero fills the first screen below the
       61px nav, so a visitor sees the product before any of the page below it. */
    @media (min-width: 1101px) {
        .hero {
            display: flex;
            align-items: center;
            min-height: calc(100svh - 61px);
            padding: 48px 0;
        }

        .hero > .wrap {
            width: 100%;
        }
    }

    @media (max-width: 1100px) {
        .hero-grid {
            grid-template-columns: minmax(0, 1fr);
            gap: 40px;
        }
    }

    @media (max-width: 640px) {
        .hero {
            padding-top: 32px;
        }

        .hero-grid {
            gap: 28px;
        }

        .hero-title {
            font-size: clamp(40px, 11vw, 48px);
        }

        .hero-sub {
            font-size: 16px;
        }

        #hero-dl {
            display: none;
        }

        .cta-row {
            margin-top: 16px;
        }

        .stage-tabs,
        .stage-desc {
            display: none;
        }

        .stage-bar {
            display: flex;
        }

        .seg button {
            width: 44px;
            height: 44px;
        }

        /* On a phone the controls move under the image, within reach of a thumb. */
        .viewer-bar {
            order: 1;
            gap: 10px;
            height: 60px;
            padding: 0 8px 0 16px;
            border-top: 1px solid var(--color-border);
            border-bottom: 0;
        }

        .viewer-actions {
            gap: 6px;
        }

        .viewer-close {
            height: 44px;
        }

        .viewer-close kbd {
            display: none;
        }

        .viewer-body {
            padding: 16px 0;
        }

        .viewer-shot :global(img) {
            max-height: calc(100dvh - 60px - 32px);
            border-radius: 0;
            border-width: 1px 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .stage-shot,
        .viewer-shot,
        .viewer,
        .viewer::backdrop {
            transition: none;
        }
    }
</style>
