---
import type { Release } from '../lib/github'

interface Props {
    activePage?: string
    release?: Release | null
}
const { activePage = '', release = null } = Astro.props

const fallback = 'https://github.com/modrexio/modrex/releases/latest'
const winUrl =
    release?.assets.find((a) => a.name.endsWith('.exe'))?.browser_download_url ?? fallback
const linUrl =
    release?.assets.find((a) => a.name.endsWith('.AppImage'))?.browser_download_url ?? fallback
---

<nav>
    <div class="wrap nav-inner">
        <a href="/" class="modrex-wordmark">MOD<span>REX</span></a>
        <div class="nav-links">
            <a href="/#screenshots">Screenshots</a>
            <a href="/#features">Features</a>
            <a href="/#download">Download</a>
            <a href="/#changelog">Changelog</a>
            <a href="/docs/" class:list={[{ active: activePage === 'docs' }]}>Docs</a>
        </div>
        <div class="nav-right">
            <a
                href="https://github.com/modrexio/modrex"
                class="social-link"
                target="_blank"
                rel="noopener"
                aria-label="GitHub"
                title="GitHub"
            >
                <span class="social-icon github" aria-hidden="true"></span>
            </a>
            <a
                href="https://discord.gg/QM2rDgy43Y"
                class="social-link"
                target="_blank"
                rel="noopener"
                aria-label="Discord"
                title="Discord"
            >
                <span class="social-icon discord" aria-hidden="true"></span>
            </a>
            <a
                id="nav-dl-btn"
                href={winUrl}
                data-win={winUrl}
                data-lin={linUrl}
                class="btn-lg primary nav-dl-btn"
                style="padding: 8px 16px; font-size: 13px"
            >
                Download
            </a>
        </div>
        <button
            class="hamburger"
            id="nav-hamburger"
            aria-label="Toggle navigation"
            aria-expanded="false"
        >
            <i data-lucide="menu" class="icon-open"></i>
            <i data-lucide="x" class="icon-close"></i>
        </button>
    </div>
    <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
        <div class="wrap mobile-links">
            <a href="/#screenshots">Screenshots</a>
            <a href="/#features">Features</a>
            <a href="/#download">Download</a>
            <a href="/#changelog">Changelog</a>
            <a href="/docs/" class:list={[{ active: activePage === 'docs' }]}>Docs</a>
            <div class="mobile-actions">
                <a
                    href="https://github.com/modrexio/modrex"
                    class="social-link"
                    target="_blank"
                    rel="noopener"
                    aria-label="GitHub"
                    title="GitHub"
                >
                    <span class="social-icon github" aria-hidden="true"></span>
                </a>
                <a
                    href="https://discord.gg/QM2rDgy43Y"
                    class="social-link"
                    target="_blank"
                    rel="noopener"
                    aria-label="Discord"
                    title="Discord"
                >
                    <span class="social-icon discord" aria-hidden="true"></span>
                </a>
                <a
                    id="mobile-dl-btn"
                    href={winUrl}
                    data-win={winUrl}
                    data-lin={linUrl}
                    class="btn-lg primary mobile-dl-btn"
                >
                    Download
                </a>
            </div>
        </div>
    </div>
</nav>

<script>
    import { createIcons, Menu, X } from 'lucide'
    import { detectOs } from '../lib/os-detect'

    createIcons({ icons: { Menu, X } })

    const navDlBtn = document.getElementById('nav-dl-btn') as HTMLAnchorElement | null
    const mobileDlBtn = document.getElementById('mobile-dl-btn') as HTMLAnchorElement | null
    const { isMobile, isLinux } = detectOs()
    if (!isMobile && isLinux) {
        if (navDlBtn) navDlBtn.href = navDlBtn.dataset.lin ?? navDlBtn.href
        if (mobileDlBtn) mobileDlBtn.href = mobileDlBtn.dataset.lin ?? mobileDlBtn.href
    }

    const hamburger = document.getElementById('nav-hamburger')
    const mobileMenu = document.getElementById('mobile-menu')
    hamburger?.addEventListener('click', () => {
        const open = mobileMenu?.classList.toggle('open')
        hamburger.setAttribute('aria-expanded', String(!!open))
        mobileMenu?.setAttribute('aria-hidden', String(!open))
    })
    mobileMenu?.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => {
            mobileMenu.classList.remove('open')
            hamburger?.setAttribute('aria-expanded', 'false')
            mobileMenu.setAttribute('aria-hidden', 'true')
        })
    )

    // Scrollspy: highlight the nav tab of the section currently in view. Only
    // does anything on the homepage, where the section anchors exist.
    const spyLinks = [
        ...document.querySelectorAll<HTMLAnchorElement>(
            '.nav-links a[href^="/#"], .mobile-links a[href^="/#"]'
        ),
    ]
    const sections = [...new Set(spyLinks.map((link) => link.hash.slice(1)))]
        .map((id) => document.getElementById(id))
        .filter((section): section is HTMLElement => section !== null)

    if (sections.length > 0) {
        let ticking = false

        const updateActive = () => {
            ticking = false
            // Active = the last section whose anchor position has reached the sticky
            // nav. The section's own scroll-margin counts, so a nav link always
            // lights up the section it scrolled to.
            let currentId = ''
            for (const section of sections) {
                const { top } = section.getBoundingClientRect()
                const margin = parseFloat(getComputedStyle(section).scrollMarginTop)
                if (top - margin <= 80) currentId = section.id
            }
            spyLinks.forEach((link) =>
                link.classList.toggle('active', link.hash === `#${currentId}`)
            )
        }

        const onScroll = () => {
            if (ticking) return
            ticking = true
            requestAnimationFrame(updateActive)
        }

        window.addEventListener('scroll', onScroll, { passive: true })
        window.addEventListener('resize', onScroll, { passive: true })
        // Some browser extensions hide the page while it loads, so every section
        // measures zero and the last one wins. Rechecking when the page changes
        // size corrects it once the page appears, without waiting for a scroll.
        new ResizeObserver(onScroll).observe(document.body)
        updateActive()
    }
</script>

<style>
    nav {
        position: sticky;
        top: 0;
        z-index: 40;
        background: var(--color-surface);
        border-bottom: 1px solid var(--color-border);
    }

    .nav-inner {
        display: flex;
        align-items: center;
        gap: 32px;
        height: 60px;
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .nav-links a {
        color: var(--text-secondary);
        font-size: 14px;
        text-decoration: none;
        white-space: nowrap;
    }

    .nav-links a:hover,
    .nav-links a.active {
        color: var(--color-text);
    }

    .nav-right {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .nav-dl-btn {
        margin-left: 8px;
    }

    .modrex-wordmark {
        font-size: 26px;
    }

    .social-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        flex: 0 0 36px;
        border-radius: var(--radius-sm);
        color: var(--color-text-muted);
        text-decoration: none;
        transition: var(--transition-colors);
    }

    .social-link:hover {
        color: var(--color-text);
        background: var(--color-surface-hover);
    }

    .social-link:focus-visible {
        outline: 2px solid var(--color-accent-bright);
        outline-offset: 2px;
    }

    .social-icon {
        display: block;
        width: 18px;
        height: 18px;
        background: currentColor;
        mask-position: center;
        mask-repeat: no-repeat;
        mask-size: contain;
        -webkit-mask-position: center;
        -webkit-mask-repeat: no-repeat;
        -webkit-mask-size: contain;
    }

    .social-icon.github {
        mask-image: url('/icons/github.svg');
        -webkit-mask-image: url('/icons/github.svg');
    }

    .social-icon.discord {
        mask-image: url('/icons/discord.svg');
        -webkit-mask-image: url('/icons/discord.svg');
    }

    .hamburger {
        display: none;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        margin-left: auto;
        margin-right: -10px;
        padding: 0;
        border: none;
        border-radius: var(--radius-sm);
        background: none;
        color: var(--color-text);
        cursor: pointer;
    }

    .hamburger:hover {
        background: var(--color-surface-hover);
    }

    .hamburger i,
    .hamburger svg {
        display: block;
        width: 20px;
        height: 20px;
    }

    .hamburger .icon-close,
    .hamburger[aria-expanded='true'] .icon-open {
        display: none;
    }

    .hamburger[aria-expanded='true'] .icon-close {
        display: block;
    }

    .mobile-menu {
        display: none;
    }

    .mobile-links {
        display: flex;
        flex-direction: column;
        padding-top: 4px;
        padding-bottom: 16px;
    }

    .mobile-links > a:not(.btn-lg) {
        color: var(--text-secondary);
        font-size: 15px;
        text-decoration: none;
        padding: 12px 0;
        border-bottom: 1px solid var(--color-border);
    }

    .mobile-links > a:not(.btn-lg):last-of-type {
        border-bottom: none;
    }

    .mobile-links > a:not(.btn-lg):hover,
    .mobile-links > a:not(.btn-lg).active {
        color: var(--color-text);
    }

    .mobile-actions {
        display: flex;
        align-items: center;
        gap: 4px;
        margin-left: -10px;
        padding-top: 8px;
    }

    .mobile-actions .social-link {
        width: 44px;
        height: 44px;
        flex-basis: 44px;
    }

    .mobile-dl-btn {
        display: none;
    }

    @media (max-width: 50rem) {
        .nav-links,
        .nav-right {
            display: none;
        }

        .hamburger {
            display: flex;
        }

        .mobile-menu {
            position: absolute;
            top: 100%;
            right: 0;
            left: 0;
            z-index: 1;
            display: block;
            visibility: hidden;
            opacity: 0;
            border-top: 1px solid var(--color-border);
            border-bottom: 1px solid var(--color-border);
            background: var(--color-surface);
            box-shadow: var(--shadow-md);
            transform: translateY(-4px);
            transition:
                opacity 150ms var(--ease),
                transform 150ms var(--ease),
                visibility 0s linear 150ms;
        }

        .mobile-menu.open {
            visibility: visible;
            opacity: 1;
            transform: translateY(0);
            transition-delay: 0s;
        }
    }

    @media (max-width: 50rem) and (prefers-reduced-motion: reduce) {
        .mobile-menu {
            transition: none;
            transform: none;
        }
    }
</style>
