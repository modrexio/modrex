---
import { GAMES } from '@modrex/games'
import { docsGames } from '../../data/docsGames'
---

<div class="game-support-table">
    <table>
        <thead>
            <tr>
                <th>Game</th>
                <th>Launchers</th>
                <th>Primary mod targets</th>
            </tr>
        </thead>
        <tbody>
            {
                docsGames.map((game) => (
                    <tr>
                        <td>
                            {game.hasPage ? (
                                <a href={`/docs/games/${game.slug}`}>{GAMES[game.id].name}</a>
                            ) : (
                                GAMES[game.id].name
                            )}
                        </td>
                        <td>{GAMES[game.id].launchers.join(', ')}</td>
                        <td>
                            {game.targets
                                .filter((target) => 'targetId' in target)
                                .map((target) => target.label)
                                .join(', ')}
                        </td>
                    </tr>
                ))
            }
        </tbody>
    </table>
</div>

<style>
    .game-support-table {
        overflow-x: auto;
    }

    .game-support-table td:first-child {
        min-width: 12rem;
    }
</style>
