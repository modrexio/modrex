---
import { GAMES, LAUNCHERS } from '@modrex/games'
import { docsGames } from '../../data/docsGames'
import SupportBadge from './SupportBadge.astro'
import LauncherIcon from './LauncherIcon.astro'
---

<table class="docs-data-table">
    <thead>
        <tr>
            <th>Game</th>
            {LAUNCHERS.map((launcher) => (
                <th>
                    <LauncherIcon launcher={launcher} />
                    {launcher}
                </th>
            ))}
        </tr>
    </thead>
    <tbody>
        {docsGames.map((game) => (
            <tr>
                <td>{GAMES[game.id].name}</td>
                {LAUNCHERS.map((launcher) => (
                    <td>
                        <SupportBadge supported={GAMES[game.id].launchers.includes(launcher)} />
                    </td>
                ))}
            </tr>
        ))}
    </tbody>
</table>
