---
import { GAMES, type ModTargetId } from '@modrex/games'
import { getDocsGame, type DocsGameId } from '../../data/docsGames'

interface Props {
    game: DocsGameId
}

const game = getDocsGame(Astro.props.game)
const targetPath = (targetId: ModTargetId) => {
    const target = GAMES[game.id].modTargets.find((candidate) => candidate.id === targetId)

    if (!target) {
        throw new Error(`Unknown ${game.id} mod target in documentation: ${targetId}`)
    }

    return target.path
}
---

<table class="docs-data-table">
    <thead>
        <tr>
            <th>Target</th>
            <th>Path under game folder</th>
            <th>Notes</th>
        </tr>
    </thead>
    <tbody>
        {game.targets.map((target) => (
            <tr>
                <td>{target.label}</td>
                <td>
                    {'targetId' in target || target.pathIsCode !== false ? (
                        <code>
                            {'targetId' in target ? targetPath(target.targetId) : target.path}
                        </code>
                    ) : (
                        target.path
                    )}
                </td>
                <td>{target.notes}</td>
            </tr>
        ))}
    </tbody>
</table>
