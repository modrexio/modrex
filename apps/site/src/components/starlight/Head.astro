---
import Default from '@astrojs/starlight/components/Head.astro'
import { getOgImage } from '../../lib/og-image'

// Starlight emits twitter:card as summary_large_image but supplies no image of its own,
// which renders every shared docs link as a bare text card. Same generated file the rest
// of the site uses, so it costs no extra build output.
const ogImage = await getOgImage()
const ogImageUrl = new URL(ogImage.src, Astro.site).href
const ogImageAlt = 'The Modrex desktop mod manager'

// entry can be undefined for some Starlight page types (autogenerated section indexes)
const entry = Astro.props.entry as { data?: { title?: string } } | undefined
const entryTitle = entry?.data?.title ?? ''

const pathname = Astro.url.pathname.replace(/\/$/, '')
const segments = pathname.split('/').filter(Boolean)

// --- Breadcrumb ---

const SECTION_LABELS: Record<string, string> = {
    games: 'Games',
    concepts: 'Concepts',
}

const breadcrumbItems: Array<{ name: string; item?: string }> = [
    { name: 'Docs', item: new URL('/docs/', Astro.site).href },
]

if (segments.length === 2 && entryTitle) {
    breadcrumbItems.push({ name: entryTitle })
} else if (segments.length >= 3) {
    const section = segments[1]
    const sectionLabel = SECTION_LABELS[section]
    if (sectionLabel) {
        breadcrumbItems.push({
            name: sectionLabel,
            item: new URL(`/docs/${section}/`, Astro.site).href,
        })
    }
    if (entryTitle) {
        breadcrumbItems.push({ name: entryTitle })
    }
}

const emitBreadcrumb = breadcrumbItems.length >= 2

const breadcrumb = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        ...(b.item ? { item: b.item } : {}),
    })),
}

// --- HowTo (getting-started) ---

const isGettingStarted = pathname === '/docs/getting-started'

const howTo = {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to install Modrex mod manager',
    description: 'Download and install Modrex on 64-bit Windows or Linux.',
    step: [
        {
            '@type': 'HowToStep',
            position: '1',
            name: 'Install on Windows',
            text: 'Download modrex_x86_64.exe from the latest release and run it, or run winget install modrex.',
        },
        {
            '@type': 'HowToStep',
            position: '2',
            name: 'Install on Linux',
            text: 'Download the .deb, .rpm or .AppImage package from the latest release and install it, or run curl -fsSL https://modrex.net/install.sh | sh.',
        },
    ],
}

// --- Organization ---

// Duplicated intent, not duplicated code path: BaseLayout emits the same entity for
// non-docs pages, and docs pages never render BaseLayout.
const organization = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Modrex',
    url: 'https://modrex.net',
    logo: new URL('/icon.png', Astro.site).href,
    sameAs: ['https://github.com/modrexio/modrex', 'https://discord.gg/QM2rDgy43Y'],
}

// --- FAQPage (troubleshooting) ---

const isTroubleshooting = pathname === '/docs/troubleshooting'

const faqPage = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
        {
            '@type': 'Question',
            name: 'Why are my mods not loading?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: "Check that the loader the game needs is installed. For example, PAYDAY 3 loads pak mods only through UE4SS. Then check that the mod is enabled, isn't overridden by a higher-priority mod, and targets your game version.",
            },
        },
        {
            '@type': 'Question',
            name: "Modrex can't detect my game — what do I do?",
            acceptedAnswer: {
                '@type': 'Answer',
                text: "Go to Settings > Game > Game Path and click Browse. Navigate to the game's installation root folder and click Select Folder. Modrex will validate and save the path.",
            },
        },
        {
            '@type': 'Question',
            name: "What does the 'Missing file' badge on a mod mean?",
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'Modrex references a file or folder that no longer exists on disk, usually after manually deleting files or moving your game folder. Either Reinstall the mod or click Remove to clear the stale entry.',
            },
        },
        {
            '@type': 'Question',
            name: 'Modrex says it cannot install an archive — why?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: "The archive likely belongs inside another mod or has a layout that does not identify a supported install target. Follow the author's instructions shown in the dialog, then install the files manually if needed.",
            },
        },
        {
            '@type': 'Question',
            name: "Modrex won't launch after a Windows update",
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'Xbox app installs can lose their file permissions after major Windows updates. Run Modrex as administrator once to restore access, then relaunch normally.',
            },
        },
        {
            '@type': 'Question',
            name: 'Where is the Modrex log file?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'On Windows: %LOCALAPPDATA%\\Modrex\\logs\\Modrex.log. On Linux: ~/.local/share/modrex/logs/Modrex.log. You can also open it from Settings > Advanced > Logs > Open log file.',
            },
        },
    ],
}
---

<Default {...Astro.props} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/jpeg" />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(organization)} />
{
    emitBreadcrumb && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />
    )
}
{
    isGettingStarted && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(howTo)} />
    )
}
{
    isTroubleshooting && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(faqPage)} />
    )
}
