---
import PagefindSearch from '@astrojs/starlight/components/Search.astro'

const label = 'Search docs'
---

<div class="docs-search">
    <button type="button" class="docs-search-field" data-docs-search-trigger>
        <svg
            aria-hidden="true"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
        </svg>
        <span>{label}</span>
        <kbd class="docs-search-shortcut" aria-hidden="true">
            <kbd>{Astro.locals.t('search.ctrlKey')}</kbd>
            <kbd>K</kbd>
        </kbd>
    </button>
    <PagefindSearch class="docs-pagefind-search" />
</div>

<script>
    const trigger = document.querySelector<HTMLButtonElement>('[data-docs-search-trigger]')!
    const searchButton = document.querySelector<HTMLButtonElement>(
        '.docs-pagefind-search button[data-open-modal]'
    )!

    if (/(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
        trigger.querySelector('.docs-search-shortcut kbd')!.textContent = '⌘'
    }

    // Starlight closes its search on any click outside the dialog, and starts
    // listening while this click is still bubbling, so it must stop here or the
    // dialog closes the moment it opens.
    trigger.addEventListener('click', (event) => {
        event.stopPropagation()
        searchButton.click()
    })

    // Starlight never starts Pagefind under astro dev and shows a notice instead.
    // The dev-search integration serves an index there, so the notice is swapped
    // for the search box and started the way Starlight starts it in a build.
    if (import.meta.env.DEV) {
        const siteSearch = searchButton.closest<HTMLElement>('site-search')!
        const notice = siteSearch.querySelector('.dialog-frame > div')!
        // Starlight scopes its search styles to its own component, so the new
        // elements carry the notice's scope class or the field loses its width.
        const scope = notice.className
        const container = document.createElement('div')
        container.className = `search-container ${scope}`
        container.innerHTML = `<div id="starlight__search" class="${scope}"></div>`
        notice.replaceWith(container)

        // Starlight's ranking settings, so results come back in the same order.
        // @ts-expect-error Starlight declares this module for its own sources only.
        const { pagefindUserConfig } = await import('virtual:starlight/pagefind-config')
        // @ts-expect-error The package ships no type declarations.
        const { PagefindUI } = await import('@pagefind/default-ui')
        new PagefindUI({
            ...pagefindUserConfig,
            element: '#starlight__search',
            baseUrl: '/',
            bundlePath: '/pagefind/',
            showImages: false,
            showSubResults: true,
            translations: JSON.parse(siteSearch.dataset.translations!),
        })
    }
</script>
