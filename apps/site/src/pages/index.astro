---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getOgImage } from '../lib/og-image'
import Nav from '../components/Nav.astro'
import Hero from '../components/Hero.astro'
import Features from '../components/Features.astro'
import DownloadSection from '../components/DownloadSection.astro'
import Changelog from '../components/Changelog.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { getLatestRelease, getRecentReleases } from '../lib/github'
import type { Release } from '../lib/github'
import { getModIndexStats } from '../lib/mod-index'
import type { ModIndexStats } from '../lib/mod-index'
import { getNexusModCounts } from '../lib/nexus-mod-count'
import type { NexusModCounts } from '../lib/nexus-mod-count'

// Both fetches degrade gracefully (generic download links, no changelog section),
// but log loudly: without GITHUB_TOKEN set, shared CI build IPs hit GitHub's
// unauthenticated rate limit and the failure is otherwise invisible in the deploy.
let release: Release | null = null
try {
    release = await getLatestRelease()
} catch (error) {
    console.error('Failed to load latest release', error)
}

let recentReleases: Release[] = []
try {
    recentReleases = await getRecentReleases(3)
} catch (error) {
    console.error('Failed to load recent releases', error)
}

let indexStats: ModIndexStats | null = null
try {
    indexStats = await getModIndexStats()
} catch (error) {
    console.error('Failed to load mod index stats', error)
}

let nexusModCounts: NexusModCounts | null = null
try {
    nexusModCounts = await getNexusModCounts()
} catch (error) {
    console.error('Failed to load Nexus mod counts', error)
}

const ogImage = await getOgImage()

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Modrex',
    description:
        'Free, open-source mod manager for PAYDAY 3, PAYDAY 2, PAYDAY: The Heist, Crime Boss: Rockay City, RAID: World War II, and Ready or Not. Browse ModWorkshop and Nexus Mods, install supported mods, and launch games from the app.',
    operatingSystem: ['Windows', 'Linux'],
    applicationCategory: 'GameApplication',
    offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
    },
    url: 'https://modrex.net',
    downloadUrl: 'https://github.com/modrexio/modrex/releases/latest',
    softwareVersion: release?.tag_name?.replace(/^v/, '') ?? undefined,
}
---

<BaseLayout
    title="Modrex"
    description="Free, open-source mod manager for PAYDAY 3, PAYDAY 2, PAYDAY: The Heist, Crime Boss, RAID, and Ready or Not. Mods from ModWorkshop and Nexus Mods."
    ogImage={new URL(ogImage.src, Astro.site).href}
    ogImageAlt="Browsing ModWorkshop mods in the Modrex desktop app"
    ogImageWidth={1200}
    ogImageHeight={630}
>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} slot="head" />
    <Nav release={release} />
    <Hero release={release} />
    <Features indexStats={indexStats} nexusModCounts={nexusModCounts} />
    <DownloadSection release={release} />
    <Changelog releases={recentReleases} />
    <SiteFooter />
</BaseLayout>
