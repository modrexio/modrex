---
import BaseLayout from '../layouts/BaseLayout.astro'
import Nav from '../components/Nav.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { formatLastUpdated } from '../lib/legal'

// Bump when the wording below changes in substance. `pnpm check-legal-dates` fails the
// build if this page is committed with a date older than the commit touching it.
const LAST_UPDATED = '2026-10-01'
---

<BaseLayout
    title="Terms of Service"
    description="Terms of Service for Modrex, the free and open-source desktop mod manager."
>
    <Nav />
    <main class="legal-page">
        <div class="wrap">
            <div class="prose">
                <h1>Terms of Service</h1>
                <p class="updated">Last updated: {formatLastUpdated(LAST_UPDATED)}</p>

                <p>
                    Modrex is a free, open-source desktop application for managing game mods. By
                    using Modrex you agree to these terms.
                </p>

                <h2>1. Use at your own risk</h2>
                <p>
                    Modrex is provided <strong>"as is"</strong> without warranties of any kind.
                    Installing, enabling, or managing mods may affect your game, save files, or
                    online status. You are solely responsible for any consequences of using mods
                    with your games.
                </p>

                <h2>2. Mod content</h2>
                <p>
                    Modrex does not host, distribute, or endorse any mods. All mod files are
                    downloaded from{' '}
                    <a href="https://modworkshop.net" target="_blank" rel="noopener">
                        modworkshop.net
                    </a>
                    ,{' '}
                    <a href="https://www.nexusmods.com" target="_blank" rel="noopener">
                        Nexus Mods
                    </a>
                    , or other third-party sources at your direction. You are responsible for
                    ensuring that the mods you install comply with the terms of service of the
                    relevant game publisher and the original mod author's license.
                </p>

                <h2>3. Third-party accounts</h2>
                <p>
                    Installing from Nexus Mods requires signing in to your own Nexus Mods account.
                    That sign-in happens in your browser, and your use of Nexus Mods is governed by
                    their{' '}
                    <a
                        href="https://help.nexusmods.com/article/18-terms-of-service"
                        target="_blank"
                        rel="noopener"
                    >
                        Terms of Service
                    </a>{' '}
                    in addition to these terms. Modrex stores the resulting sign-in tokens on your
                    own device and never transmits them to us; see the{' '}
                    <a href="/privacy">Privacy Policy</a> for how they are stored and how to remove
                    them. You are responsible for keeping your account credentials secure and for
                    respecting any download or rate limits that Nexus Mods applies to your account.
                </p>

                <h2>4. Open source</h2>
                <p>
                    Modrex is released under the{' '}
                    <a href="https://opensource.org/licenses/MIT" target="_blank" rel="noopener">
                        MIT License
                    </a>
                    . The source code is available on{' '}
                    <a href="https://github.com/modrexio/modrex" target="_blank" rel="noopener">
                        GitHub
                    </a>
                    . You may use, modify, and distribute it in accordance with that license.
                </p>

                <h2>5. No affiliation</h2>
                <p>
                    Modrex is an independent project and is not affiliated with, endorsed by, or
                    sponsored by any game studio, publisher, or platform.
                </p>

                <h2>6. Availability</h2>
                <p>
                    We make no guarantees about the availability or continuity of Modrex or any
                    associated services. We may update, suspend, or discontinue any part of the
                    project at any time.
                </p>

                <h2>7. Changes</h2>
                <p>
                    We may update these terms at any time. Continued use of Modrex after changes are
                    posted constitutes acceptance of the new terms.
                </p>

                <h2>8. Contact</h2>
                <p>
                    Questions or concerns? Open an issue on{' '}
                    <a
                        href="https://github.com/modrexio/modrex/issues"
                        target="_blank"
                        rel="noopener"
                    >
                        GitHub
                    </a>{' '}
                    or reach out via our{' '}
                    <a href="https://discord.gg/QM2rDgy43Y" target="_blank" rel="noopener">
                        Discord
                    </a>
                    .
                </p>
            </div>
        </div>
    </main>
    <SiteFooter />
</BaseLayout>

<style>
    .legal-page {
        padding: 80px 0 96px;
    }

    .prose {
        max-width: 680px;
    }

    h1 {
        margin: 0 0 24px;
        font-family: var(--font-display);
        font-size: clamp(36px, 5vw, 56px);
        line-height: 1;
        letter-spacing: var(--tracking-display);
    }

    .updated {
        margin: -12px 0 24px;
        font-size: 12px;
        font-weight: 600;
        color: var(--color-text);
    }

    h2 {
        margin: 40px 0 10px;
        font-size: 16px;
        font-weight: 600;
        color: var(--color-text);
    }

    p {
        margin: 0 0 16px;
        font-size: 15px;
        color: var(--text-secondary);
        line-height: 1.7;
    }

    a {
        color: var(--color-accent-bright);
        text-decoration: none;
    }

    a:hover {
        text-decoration: underline;
    }

    strong {
        color: var(--color-text);
        font-weight: 500;
    }
</style>
