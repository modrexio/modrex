{
    "name": "modrex-workspace",
    "version": "0.13.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.32.1",
    "scripts": {
        "dev": "pnpm --dir apps/desktop dev",
        "dev-renderer": "pnpm --dir apps/desktop dev-renderer",
        "build": "pnpm --dir apps/desktop build",
        "build:signed": "pnpm --dir apps/desktop build:signed",
        "build-renderer": "pnpm --dir apps/desktop build-renderer",
        "dist": "pnpm --dir apps/desktop dist",
        "dist:win": "pnpm --dir apps/desktop dist:win",
        "dist:linux": "pnpm --dir apps/desktop dist:linux",
        "typecheck": "pnpm --dir apps/desktop typecheck && pnpm site:typecheck && pnpm site:typecheck:functions && pnpm index:typecheck",
        "check-version": "pnpm --dir apps/desktop check-version",
        "check-commands": "pnpm --dir apps/desktop check-commands",
        "check-csp": "pnpm --dir apps/desktop check-csp",
        "check-games": "pnpm --dir apps/desktop check-games",
        "check-sources": "pnpm --dir apps/desktop check-sources",
        "check-updater": "pnpm --dir apps/desktop check-updater",
        "check-i18n": "pnpm --dir apps/desktop check-i18n",
        "i18n:help": "pnpm --dir apps/desktop i18n:help",
        "i18n:status": "pnpm --dir apps/desktop i18n:status",
        "i18n:missing": "pnpm --dir apps/desktop i18n:missing",
        "i18n:check": "pnpm --dir apps/desktop i18n:check",
        "i18n:fill": "pnpm --dir apps/desktop i18n:fill",
        "i18n:translate": "pnpm --dir apps/desktop i18n:translate",
        "i18n:create": "pnpm --dir apps/desktop i18n:create",
        "update-i18n-readme": "pnpm --dir apps/desktop update-i18n-readme",
        "checks": "pnpm check-version && pnpm check-commands && pnpm check-csp && pnpm check-games && pnpm check-sources && pnpm check-updater && pnpm check-i18n && pnpm site:check-legal-dates && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm site:build",
        "test": "pnpm --dir apps/desktop test && pnpm site:test && pnpm index:test",
        "test:renderer": "pnpm --dir apps/desktop test:renderer",
        "format": "prettier --write . && pnpm --dir apps/site format",
        "format:check": "prettier --check . && pnpm site:format:check",
        "lint": "pnpm --dir apps/desktop lint && pnpm site:lint",
        "lint:fix": "pnpm --dir apps/desktop lint:fix && pnpm --dir apps/site lint:fix",
        "generate-licenses": "pnpm --dir apps/desktop generate-licenses",
        "preversion": "node apps/desktop/scripts/check-release-tree.mjs",
        "version": "node apps/desktop/scripts/version.mjs",
        "site:dev": "pnpm --dir apps/site dev",
        "site:build": "pnpm --dir apps/site build",
        "site:typecheck": "pnpm --dir apps/site typecheck",
        "site:typecheck:functions": "pnpm --dir apps/site typecheck:functions",
        "site:check-legal-dates": "pnpm --dir apps/site check-legal-dates",
        "site:lint": "pnpm --dir apps/site lint",
        "site:test": "pnpm --dir apps/site test:run",
        "site:format:check": "pnpm --dir apps/site format:check",
        "site:checks": "pnpm site:typecheck && pnpm site:typecheck:functions && pnpm site:check-legal-dates && pnpm site:lint && pnpm site:format:check && pnpm site:test && pnpm site:build",
        "index:build": "pnpm --dir apps/index build-index",
        "index:test": "pnpm --dir apps/index test:staged-rebuild",
        "index:typecheck": "pnpm --dir apps/index exec tsc --noEmit",
        "audit:deps": "pnpm audit",
        "prepare": "husky"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.1",
        "@commitlint/config-conventional": "21.2.0",
        "husky": "^9.1.7",
        "prettier": "^3.9.6",
        "typescript": "6.0.3"
    },
    "pnpm": {
        "overrides": {
            "postcss": "8.5.25",
            "esbuild": ">=0.28.1",
            "brace-expansion": ">=5.0.8",
            "fast-uri": "3.1.5"
        }
    }
}
