{
    "name": "modrex",
    "version": "0.12.2",
    "type": "module",
    "packageManager": "pnpm@10.32.1",
    "scripts": {
        "dev": "tauri dev",
        "dev-renderer": "vite",
        "build": "tauri build",
        "build-renderer": "vite build",
        "dist": "tauri build",
        "dist:win": "tauri build --target x86_64-pc-windows-msvc",
        "dist:linux": "tauri build --target x86_64-unknown-linux-gnu",
        "typecheck": "tsc --noEmit",
        "check-commands": "node scripts/check-commands.mjs",
        "prepare": "husky",
        "version": "node scripts/version.mjs",
        "test": "cargo test --manifest-path src-tauri/Cargo.toml && vitest run",
        "test:renderer": "vitest run",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint src/renderer/src",
        "lint:fix": "eslint src/renderer/src --fix",
        "generate-licenses": "node scripts/generate-licenses.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/modrexio/modrex.git"
    },
    "keywords": [
        "modrex",
        "payday3",
        "payday2",
        "payday-the-heist",
        "crime-boss",
        "mod-manager"
    ],
    "author": "Oleh Shulha",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/modrexio/modrex/issues"
    },
    "homepage": "https://github.com/modrexio/modrex#readme",
    "description": "A desktop mod manager for PAYDAY 3, PAYDAY 2, PAYDAY: The Heist, and Crime Boss: Rockay City powered by modworkshop",
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.2",
        "@tauri-apps/cli": "^2",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^25.7.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.2.0",
        "eslint": "^10.7.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.5",
        "tailwindcss": "^4.3.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.63.0",
        "vite": "^6.4.2",
        "vite-plugin-svgr": "^5.2.0",
        "vitest": "^4.1.10"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.19",
        "@radix-ui/react-select": "^2.3.3",
        "@radix-ui/react-tabs": "^1.1.17",
        "@radix-ui/react-tooltip": "^1.2.12",
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-log": "^2.8.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "highlight.js": "^11.11.1",
        "lucide-react": "^1.24.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-markdown": "^10.1.0",
        "rehype-highlight": "^7.0.2",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "remark-breaks": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "simple-icons": "^16.25.0",
        "tailwind-merge": "^3.6.0"
    }
}
