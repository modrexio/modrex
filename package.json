{
    "name": "modrex-workspace",
    "version": "0.16.0",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.4",
    "scripts": {
        "dev": "bun run --cwd apps/desktop dev",
        "dev-renderer": "bun run --cwd apps/desktop dev-renderer",
        "build": "bun run --cwd apps/desktop build",
        "build:signed": "bun run --cwd apps/desktop build:signed",
        "build-renderer": "bun run --cwd apps/desktop build-renderer",
        "dist": "bun run --cwd apps/desktop dist",
        "dist:win": "bun run --cwd apps/desktop dist:win",
        "dist:linux": "bun run --cwd apps/desktop dist:linux",
        "typecheck": "bun run --cwd apps/desktop typecheck && bun run index:typecheck && bun run typecheck:functions && bun run typecheck:tools && bun run site:typecheck && bun run site:typecheck:functions",
        "typecheck:functions": "tsc -p functions/tsconfig.json",
        "typecheck:tools": "tsc -p tsconfig.tools.json",
        "check-version": "bun run --cwd apps/desktop check-version",
        "check-overrides": "bun run --cwd apps/desktop check-overrides",
        "check-commands": "bun run --cwd apps/desktop check-commands",
        "check-csp": "bun run --cwd apps/desktop check-csp",
        "check-updater": "bun run --cwd apps/desktop check-updater",
        "check-i18n": "bun run --cwd apps/desktop check-i18n",
        "i18n:help": "bun run --cwd apps/desktop i18n:help",
        "i18n:status": "bun run --cwd apps/desktop i18n:status",
        "i18n:missing": "bun run --cwd apps/desktop i18n:missing",
        "i18n:check": "bun run --cwd apps/desktop i18n:check",
        "i18n:fill": "bun run --cwd apps/desktop i18n:fill",
        "i18n:translate": "bun run --cwd apps/desktop i18n:translate",
        "i18n:review": "bun run --cwd apps/desktop i18n:review",
        "i18n:create": "bun run --cwd apps/desktop i18n:create",
        "i18n:sync": "bun run --cwd apps/desktop i18n:sync",
        "i18n:status-svg": "bun run --cwd apps/desktop i18n:status-svg",
        "i18n:check-readonly": "bun run --cwd apps/desktop i18n:check-readonly",
        "i18n:check-staged": "bun run --cwd apps/desktop i18n:check-staged",
        "i18n:check-sync": "bun run --cwd apps/desktop i18n:check-sync",
        "i18n:presentation-check": "bun run --cwd apps/desktop i18n:presentation-check",
        "i18n:presentation-write": "bun run --cwd apps/desktop i18n:presentation-write",
        "update-i18n-readme": "bun run --cwd apps/desktop update-i18n-readme",
        "checks": "bun run check-version && bun run check-overrides && bun run check-commands && bun run check-csp && bun run check-updater && bun run check-i18n && bun run site:check-legal-dates && bun run format:check && bun run lint && bun run typecheck && bun run test && bun run site:build",
        "test": "bun run --cwd apps/desktop test && bun run site:test && bun run index:test",
        "test:renderer": "bun run --cwd apps/desktop test:renderer",
        "format": "bun fmt --no-script && bun run --cwd apps/site format",
        "format:check": "bun fmt --no-script --check && bun run site:format:check",
        "lint": "bun run --cwd apps/desktop lint && bun run site:lint",
        "lint:fix": "bun run --cwd apps/desktop lint:fix && bun run --cwd apps/site lint:fix",
        "generate-licenses": "bun run --cwd apps/desktop generate-licenses",
        "preversion": "bun -e \"console.error('Run bun release patch, minor, or major from the repository root.'); process.exit(1)\"",
        "release": "bun apps/desktop/scripts/release.mts",
        "site:dev": "bun run --cwd apps/site dev",
        "site:build": "bun run --cwd apps/site build",
        "site:typecheck": "bun run --cwd apps/site typecheck",
        "site:typecheck:functions": "bun run --cwd apps/site typecheck:functions",
        "site:check-legal-dates": "bun run --cwd apps/site check-legal-dates",
        "site:lint": "bun run --cwd apps/site lint",
        "site:test": "bun run --cwd apps/site test:run",
        "site:format:check": "bun run --cwd apps/site format:check",
        "site:checks": "bun run site:typecheck && bun run site:typecheck:functions && bun run site:check-legal-dates && bun run site:lint && bun run site:format:check && bun run site:test && bun run site:build",
        "index:build": "bun run --cwd apps/index build-index",
        "index:test": "bun run --cwd apps/index test:export-determinism && bun run --cwd apps/index test:snapshot-delta && bun run --cwd apps/index test:game-schedule && bun run --cwd apps/index test:marker-contract && bun run --cwd apps/index test:marker-archive && bun run --cwd apps/index test:process-failure && bun run --cwd apps/index test:postgres-architecture && bun run --cwd apps/index test:postgres-queries && bun run --cwd apps/index test:staged-rebuild && bun run --cwd apps/index test:unreal-resources",
        "index:typecheck": "bun run --cwd apps/index tsc --noEmit",
        "prepare": "husky",
        "i18n:typecheck": "bun run --cwd apps/desktop typecheck:i18n"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@commitlint/types": "21.2.3",
        "@types/bun": "^1.4.4",
        "husky": "^9.1.7",
        "typescript": "7.0.2"
    },
    "overrides": {
        "http-cache-semantics": "4.3.0",
        "postcss": "8.5.25",
        "postcss-selector-parser": "7.1.6",
        "source-map-js": "1.2.2",
        "esbuild": ">=0.28.1",
        "brace-expansion": "5.0.12",
        "browserslist": "4.28.7",
        "fast-uri": "3.1.9",
        "js-yaml": "^4.3.2",
        "@babel/core": "^7.29.6",
        "rolldown": "1.2.13",
        "vite": "8.3.4",
        "@types/node": "^26.6.5"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "trustedDependencies": [
        "esbuild"
    ]
}
