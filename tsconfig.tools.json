{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["bun"],
        "noEmit": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true
    },
    "include": ["commitlint.config.ts", ".github/scripts/*.mts"]
}
